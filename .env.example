# Lista JSON de origens. O adaptador é selecionado automaticamente pelo domínio.
# Uma origem pode ser uma URL simples ou um objeto com limite e dados do anunciante.
AGENT_CARS_SOURCES='["https://casadoautomovel.com.br/seminovos-cidade-do-automovel-brasilia-df?marca=&carro-modelo=&valorInicial=&valorFinal=&anoInicial=&anoFinal=","https://salaodoauto.com.br/seminovos-cidade-do-automovel-brasilia-df","https://brasiliamotos.com.br/multipla"]'
AGENT_CARS_INTERVAL=hourly
AGENT_CARS_LIMIT=15
